<odoo>

    <!-- Multi-company: managers only see backups belonging to their active companies -->
    <record id="rule_eiw_backup_company" model="ir.rule">
        <field name="name">Export Import Web Backup: company filter</field>
        <field name="model_id" ref="model_export_import_web_backup"/>
        <field name="groups" eval="[(4, ref('export_import_web.group_export_import_web_manager'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Users can also read backups of their company -->
    <record id="rule_eiw_backup_company_user" model="ir.rule">
        <field name="name">Export Import Web Backup: company filter (user)</field>
        <field name="model_id" ref="model_export_import_web_backup"/>
        <field name="groups" eval="[(4, ref('export_import_web.group_export_import_web_user'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
