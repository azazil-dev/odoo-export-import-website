<odoo>

    <!-- Module category -->
    <record id="module_category_export_import_web" model="ir.module.category">
        <field name="name">Export Import Web</field>
        <field name="description">Manage website backup and restore operations</field>
        <field name="sequence">100</field>
    </record>

    <!-- Odoo 19: res.groups uses privilege_id linked to res.groups.privilege -->
    <record id="privilege_export_import_web" model="res.groups.privilege">
        <field name="name">Export Import Web</field>
        <field name="description">Access levels for Export Import Web: User, Manager.</field>
        <field name="category_id" ref="module_category_export_import_web"/>
        <field name="sequence">100</field>
    </record>

    <!-- User group: can view backups and download -->
    <record id="group_export_import_web_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_export_import_web"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Manager group: full access — create backups, restore, delete, configure -->
    <record id="group_export_import_web_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_export_import_web"/>
        <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
